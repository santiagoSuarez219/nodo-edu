# Supabase — obtener en supabase.com > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY — nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# URL base del sitio (para redirects OAuth y password recovery)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Question Bank — API y servicio
QUESTION_BANK_API_KEY=
QUESTION_BANK_AGENT_TEACHER_ID=
QUESTION_BANK_API_BASE_URL=http://localhost:3000/api/questions

# Students Admin — API de administración de estudiantes (students-mcp)
# Clave propia y distinta de QUESTION_BANK_API_KEY: este dominio tiene
# permisos de admin (crea, edita y elimina estudiantes con service role).
STUDENTS_ADMIN_API_KEY=
STUDENTS_ADMIN_API_BASE_URL=http://localhost:3000/api/students
