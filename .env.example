# ─────────────────────────────────────────────────────────────
# Variables de la APP (se cargan en Vercel, entorno Production)
# ─────────────────────────────────────────────────────────────

# Supabase — obtener en supabase.com > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY — nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# URL base del sitio. Reservada: hoy no tiene ninguna referencia en el
# código (no hay OAuth ni recuperación de contraseña implementados), pero se
# carga en Vercel con la URL de producción por si un flujo futuro la requiere
# (OAuth, metadataBase para SEO). Ver DEBT-014 en docs/specs/backlog.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Question Bank — clave de servicio que protege /api/questions,
# /api/assignments y /api/attendance
QUESTION_BANK_API_KEY=
QUESTION_BANK_AGENT_TEACHER_ID=

# Students Admin — clave de servicio que protege /api/students/*
# Clave propia y distinta de QUESTION_BANK_API_KEY: este dominio tiene
# permisos de admin (crea, edita y elimina estudiantes con service role).
STUDENTS_ADMIN_API_KEY=

# ─────────────────────────────────────────────────────────────
# Variables de los clientes MCP LOCALES (mcp-servers/*)
# NO se cargan en Vercel — solo las usa run-local-mcp.sh / Claude Desktop
# para apuntar a la app corriendo en npm run dev.
# ─────────────────────────────────────────────────────────────

QUESTION_BANK_API_BASE_URL=http://localhost:3000/api/questions
STUDENTS_ADMIN_API_BASE_URL=http://localhost:3000/api/students
